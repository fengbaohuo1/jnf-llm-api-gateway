{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$HOME/.llm-api-gateway/**" }]
    },
    "autostart:default",
    "clipboard-manager:default",
    "dialog:default",
    "notification:default",
    "shell:default",
    "store:default"
  ]
}
